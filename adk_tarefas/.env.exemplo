# Copie como adk_tarefas/.env apenas no seu computador. Nunca publique este arquivo.
GOOGLE_API_KEY=COLE_SUA_CHAVE_GOOGLE_AQUI
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.5-flash-lite
TRELLO_API_KEY=COLE_SUA_CHAVE_TRELLO_AQUI
